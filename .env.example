# Copy to .env and fill in the values. `.env` is gitignored; this file is not.
# Never put a real value in this file. See docs/decisions.md entry 11.

# eBay production keys, from https://developer.ebay.com/my/keys
# The client ID is labelled "App ID" and the secret "Cert ID" in that console.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
