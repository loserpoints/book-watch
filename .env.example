# Copy to .env and fill in the values. `.env` is gitignored; this file is not.
# Never put a real value in this file.

# eBay production keys, from https://developer.ebay.com/my/keys
# The client ID is labelled "App ID" and the secret "Cert ID" in that console.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# eBay marketplace account deletion endpoint. Required before the production
# keyset will work at all.
#
# The token is one you invent: 32-80 characters, letters, digits, underscores
# and hyphens only. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EBAY_VERIFICATION_TOKEN=

# Must match the URL entered in eBay's developer console exactly, including
# the scheme and any trailing slash. It is hashed into every challenge response.
EBAY_DELETION_ENDPOINT_URL=https://book-watch.fly.dev/ebay/deletion

# Where the SQLite database file lives. No default on purpose: an unset value
# that quietly wrote to the working directory would lose the want-list on
# every deploy. On Fly this points inside the mounted volume.
BOOK_WATCH_DB_PATH=./book-watch.db

# The US ZIP the books ship to (S43). eBay prices calculated shipping to it;
# without it, those copies have no delivered price. A Fly secret in
# production, since it is close to an address.
SHIP_TO_ZIP=

# The morning email (S40). A Resend API key with "Sending access" only, and
# the address it goes to, which must be the Resend account's own address while
# mail is sent from Resend's shared address. Both are Fly secrets in
# production. Leave either empty and no email is sent.
RESEND_API_KEY=
ALERT_EMAIL_TO=
